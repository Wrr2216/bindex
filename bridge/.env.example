# Reader bridge configuration. Copy to .env and fill in.

# Base URL of the server. A trailing slash is fine.
SERVER_URL=https://inventory.example.com

# Must match one of the server's INGEST_TOKEN values (generate: openssl rand -hex 24).
DEVICE_TOKEN=

# Channel the audit screen listens on. Leave it alone unless you run several readers.
READER_ID=default

# Reader serial port. The dev kit's USB/RS232 port shows up as /dev/ttyUSB0.
SERIAL_PORT=/dev/ttyUSB0
BAUD=115200

# Regulatory region: NA for 902-928 MHz, EU3 for 865-868 MHz. This must match both
# your antenna and the law where you are.
REGION=NA

# Read power in centi-dBm. The M7e-Pico tops out at +24 dBm, which is 2400.
READ_POWER=2400

# Milliseconds between batches of new EPCs.
FLUSH_MS=750

# Set to 1 to print tags to the console and post nothing, to check the reader works.
READ_TEST=
