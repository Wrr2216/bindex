# Bindex configuration.
#
# Copy to .env and edit. Only the first section is required; everything else has
# a working default or turns a feature off when left blank.
#
# Anything to do with naming, vocabulary and which features are on lives in the
# database and is edited in Settings, not here. The APP_NAME and
# ASSET_CODE_PREFIX values below only seed a brand new database.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public URL the browser reaches this at. Used to build redirect URIs.
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://bindex:bindex@localhost:5432/bindex

# Signs session cookies. Generate one: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Postgres connections held by this process. Keep the total across all replicas
# below the max_connections of the server.
DATABASE_POOL_MAX=8

LOG_LEVEL=info
# text is readable in a terminal; json suits a log aggregator.
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Who can sign in
#
#   local    email and password accounts managed in this app (default)
#   oidc     any OpenID Connect provider
#   trusted  no sign-in at all; every request is the same person. Only safe
#            where something in front of the app already decides who gets in,
#            such as a home network or an authenticating reverse proxy.
# ---------------------------------------------------------------------------
AUTH_MODE=local

# Create the first administrator on boot. Leave the password blank and the app
# serves a setup screen instead, where the first visitor creates the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Keep a password account alongside SSO, as a way back in if the provider is
# unreachable. Implied by AUTH_MODE=local.
LOCAL_LOGIN_ENABLED=false

# Restrict sign-in to these addresses, whichever method they use. Empty allows
# anyone your provider lets through.
ALLOWED_EMAILS=

# Identity used by AUTH_MODE=trusted.
TRUSTED_USER_EMAIL=owner@localhost
TRUSTED_USER_NAME=Owner

# --- OpenID Connect (AUTH_MODE=oidc) ---------------------------------------
# The issuer URL, which must serve /.well-known/openid-configuration. Examples:
#   Entra ID   https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google     https://accounts.google.com
#   Keycloak   https://sso.example.com/realms/<realm>
#   Authentik  https://sso.example.com/application/o/<slug>/
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match a redirect URI registered with the provider.
# Defaults to ${APP_BASE_URL}/auth/callback.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_BUTTON_LABEL=Sign in with SSO
# Create an account for anyone who signs in successfully. Turn off to require
# that an administrator adds them first.
OIDC_AUTO_PROVISION=true

# ---------------------------------------------------------------------------
# First-boot defaults
# These seed a brand new database. Once it has run, Settings is what matters.
# ---------------------------------------------------------------------------
APP_NAME=Bindex
ORG_NAME=
# Printed codes look like INV-4F2K1B. Letters and digits only, up to eight.
ASSET_CODE_PREFIX=INV

# ---------------------------------------------------------------------------
# Product lookup (all optional)
# Scanning an unknown barcode opens a create form. These fill it in for you.
# ---------------------------------------------------------------------------

# Barcode database. The trial endpoint works with no key at a low rate limit.
UPC_API_PROVIDER=upcitemdb
UPC_API_KEY=

# Web search, used for product photos and street prices.
# Get a key at https://brave.com/search/api/
BRAVE_API_KEY=

# Any OpenAI-compatible chat endpoint. Used to describe a product from search
# results, to read a price out of them, and for search by question. Leave
# LLM_API_KEY blank and none of that appears in the interface.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat

# ---------------------------------------------------------------------------
# NinjaOne device sync (optional)
# Administration -> Apps -> API, authorization code flow. Request the
# offline_access scope so a refresh token is issued, without which unattended
# sync stops working after an hour. Connect once from Settings.
# ---------------------------------------------------------------------------
NINJAONE_ENABLED=false
NINJAONE_BASE_URL=https://us2.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
NINJAONE_SCOPES=monitoring management offline_access
# Defaults to ${APP_BASE_URL}/api/ninjaone/callback.
NINJAONE_REDIRECT_URI=
# Machine name of the custom field that holds the asset ID.
NINJAONE_ASSET_ID_FIELD=assetId
# Minutes between syncs; 0 for manual only.
NINJAONE_SYNC_INTERVAL_MIN=720

# ---------------------------------------------------------------------------
# Domain registrar sync (optional)
# Read-only credentials. Domains arrive as items in the Domain category.
#   Cloudflare: API token with Zone:Read and Domain Registrar:Read
#   Porkbun:    Account -> API Access, then enable API access per domain
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Minutes between syncs; 0 for manual only.
REGISTRAR_SYNC_INTERVAL_MIN=1440
# Warn about domains expiring within this many days that have auto-renew off.
# Needs the notification settings below. 0 disables the digest.
DOMAIN_EXPIRY_ALERT_DAYS=30

# ---------------------------------------------------------------------------
# Label printing
# Labels print from the browser to a printer attached to that computer, so
# there is no printer to configure here. These are the printed dimensions.
# ---------------------------------------------------------------------------
# A 62 mm continuous roll cut to one inch.
LABEL_WIDTH_MM=62
LABEL_HEIGHT_MM=25.4
# Only if the driver rotates the page. One of 0, 90, 180, 270.
LABEL_ROTATE_DEG=0

# ---------------------------------------------------------------------------
# Reader bridge (optional)
# Comma-separated tokens a reader bridge sends as an Authorization bearer
# header. Empty disables the ingest endpoint. Generate: openssl rand -hex 24
# ---------------------------------------------------------------------------
INGEST_TOKEN=

# ---------------------------------------------------------------------------
# Notifications (optional)
# An ntfy topic for things nobody is watching a screen for, such as the domain
# expiry digest. Self-hosted or ntfy.sh both work.
# ---------------------------------------------------------------------------
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# ---------------------------------------------------------------------------
# Used by docker-compose.yml only
# ---------------------------------------------------------------------------
# Password for the bundled Postgres. Ignored when DATABASE_URL points elsewhere.
POSTGRES_PASSWORD=bindex
# Host port the app is published on.
APP_PORT=3000
